# PostgreSQL Database Configuration
# For local development, use your local PostgreSQL credentials
# For production, use environment variables from your hosting provider

# Example local connection:
# DATABASE_URL=postgres://username:password@localhost:5432/sonestatour

# Connection settings (used when DATABASE_URL is not set)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sonestatour
DB_USER=postgres
DB_PASSWORD=your_password_here

# Server settings
PORT=3000
NODE_ENV=development
